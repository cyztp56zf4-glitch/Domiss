{
  "name": "domiss",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI střihová a editovací aplikace pro video",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,magenta npm:dev:web npm:dev:api",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "phone": "npm run build && concurrently -k -n app,tunel -c magenta,green \"npm start\" \"npx -y cloudflared tunnel --url http://localhost:8787\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@huggingface/transformers": "^4.3.2",
    "dejavu-fonts-ttf": "^2.37.3",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
